@base = http://localhost:8080
@json = application/json

### 0) Health
GET {{base}}/

### Fetch compressed ServerKey (created on server startup)
# Response is binary. Use "Save Response" in your client to write it to disk (e.g., public/u16_server_key.bin).
GET {{base}}/server-key

### Fetch all encrypted ballots (u16 one-hot per record, base64-encoded)
GET {{base}}/user-votes

### Cast vote #1 (candidate 0)
POST {{base}}/vote
Content-Type: {{json}}

{
  "id": "u1",
  "name": "Alice Test",
  "address": "123 Test St",
  "age": 30,
  "candidate": 0
}

